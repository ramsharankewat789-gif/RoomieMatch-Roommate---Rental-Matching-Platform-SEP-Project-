# ─── RoomieMatch Backend Environment Variables ───────────────────────────────
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MySQL Database ─────────────────────────────────────────────────────────────
# Create a MySQL database named 'roomiematch' before starting the server.
# Run: npm run db:migrate   to create all tables.
# Run: npm run db:seed      to populate demo data.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=roomiematch
DB_CONNECTION_LIMIT=10

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── SMTP / Email (for OTP delivery) ──────────────────────────────────────────
# For Gmail: enable "App Passwords" in your Google account security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="RoomieMatch <no-reply@roomiematch.com>"

# ── Frontend URLs (CORS) ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── File Upload Limits (bytes) ────────────────────────────────────────────────
PROFILE_IMAGE_MAX_SIZE=5242880
PROPERTY_IMAGE_MAX_SIZE=8388608
VERIFICATION_DOC_MAX_SIZE=10485760
MAX_PROPERTY_IMAGES=6
