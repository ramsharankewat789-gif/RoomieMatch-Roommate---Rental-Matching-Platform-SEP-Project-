# ─── RoomieMatch Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# The redirect URI registered in Google Console (must match exactly)
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── SMTP / Email (for OTP delivery) ──────────────────────────────────────────
# For Gmail: enable "App Passwords" in your Google account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="RoomieMatch <no-reply@roomiematch.com>"

# ── Frontend URLs (CORS) ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── File Upload ───────────────────────────────────────────────────────────────
# Max file sizes in bytes
PROFILE_IMAGE_MAX_SIZE=5242880
PROPERTY_IMAGE_MAX_SIZE=8388608
VERIFICATION_DOC_MAX_SIZE=10485760
MAX_PROPERTY_IMAGES=6
